{
  "name": "vizo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:umbrales": "vitest run tests/umbrales",
    "test:estructura": "supabase db reset && psql \"$VIZO_DB_URL_ADMIN\" -v ON_ERROR_STOP=1 -f tests/estructura/smoke.sql",
    "test:xsd": "vitest run tests/xsd",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > src/tipos/supabase.ts",
    "demo:datos": "node --import tsx scripts/datos-demo.ts",
    "demo:datos:remoto": "node --env-file=.env.produccion --import tsx scripts/datos-demo.ts",
    "demo:ensayo": "node --import tsx scripts/ensayo-demo.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pg": "^8.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
