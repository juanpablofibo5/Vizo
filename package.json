{
  "name": "vizo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:umbrales": "vitest run tests/umbrales",
    "test:estructura": "supabase db reset && psql \"$VIZO_DB_URL\" -v ON_ERROR_STOP=1 -f tests/estructura/smoke.sql",
    "test:xsd": "vitest run tests/xsd",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/tipos/supabase.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.4",
    "pg": "^8.22.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  }
}
